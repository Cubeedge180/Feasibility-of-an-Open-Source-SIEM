#!/bin/sh
# Blocks a commit that contains a secret or a private IP address (rules in .gitleaks.toml).
# Enable once per clone:  git config core.hooksPath .githooks
# Needs gitleaks on PATH (macOS: brew install gitleaks).
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not found, commit blocked. Install it: brew install gitleaks" >&2
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml .
