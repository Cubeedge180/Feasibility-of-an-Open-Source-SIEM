# Copy to .env and adjust. Never commit .env.

# Port the ingestion API is published on.
INGEST_PORT=8000
# Host address the ingestion API binds to. 127.0.0.1 = this machine only.
# Lab: the Mac's address on the UTM Shared Network (kept in a local, untracked file, never in git).
# That interface exists only while a UTM VM is running.
INGEST_BIND=127.0.0.1

# Password of the PostgreSQL user `siem`. The database has no published port; still,
# set your own value outside the lab.
POSTGRES_PASSWORD=change-me

# Local LLM used for triage (only with: docker compose --profile llm up).
OLLAMA_PORT=11434
# PLACEHOLDER: research-design.md section 4.1 requires one 7-8B instruction model,
# named with its exact tag and digest before prereg-v1. The model is not chosen yet.
OLLAMA_MODEL=llama3.2:3b
# Fixed seed for every triage call (temperature is always 0, see triage/ollama_client.py).
OLLAMA_SEED=20261014
